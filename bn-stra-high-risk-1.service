[Unit]
Description=bn-stra-high-risk-1 Binance futures strategy bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/bn-stra-high-risk-1
EnvironmentFile=%h/bn-stra-high-risk-1/.env
ExecStart=/usr/bin/python3 %h/bn-stra-high-risk-1/bn_stra_high_risk_1.py --config %h/bn-stra-high-risk-1/config.json --log-level INFO
Restart=always
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=default.target
